{
  "name": "adamw_cos_ls",
  "fold": 4,
  "splits": "results/kfold_splits.json",
  "data_dir": "../data/final",
  "output_dir": "results/kfold",
  "pretrained_backbone": "models/backbone_scin_pretrained_v2.pth",
  "no_embed": false,
  "arch": "resnet18",
  "epochs": 40,
  "patience": 10,
  "batch_size": 16,
  "lr": 0.0001,
  "weight_decay": 0.05,
  "optimizer": "adamw",
  "scheduler": "cosine",
  "loss": "weighted_ce",
  "label_smoothing": 0.1,
  "ordinal_tau": 0.7,
  "head_lr_mult": 10.0,
  "mixup_alpha": 0.2,
  "strong_aug": false,
  "img_size": 224,
  "swa": false,
  "swa_epochs": 10,
  "seed": 42
}